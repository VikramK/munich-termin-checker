<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.munich-appointment.burst</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/anveshgopalam/.rye/shims/rye</string>
        <string>run</string>
        <string>python</string>
        <string>terminchecker.py</string>
        <string>--burst</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/anveshgopalam/Projects/munich-appointment</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/anveshgopalam/.rye/shims:/usr/local/bin:/usr/bin:/bin</string>
