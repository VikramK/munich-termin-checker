# ============================================================
# Appointment Checker & Auto-Booker - Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Environment variables take precedence over .env values.

# --- Booking details (used to fill the appointment form) ---
# Both FIRST_NAME and LAST_NAME must be set to enable auto-booking.
# If omitted, the script will detect availability but NOT auto-book.
FIRST_NAME=Your
LAST_NAME=Name

# Email address used to fill the booking form.
RECEIVER_EMAIL=your.email@example.com

# --- Target service (optional, has sensible default) ---
# Full Munich ZMS URL for the service/location you want to book.
# Default: Verpflichtungserklärung abgeben (Ruppertstraße).
# TARGET_URL=https://stadt.muenchen.de/buergerservice/terminvereinbarung.html#/services/1063741/locations/10308621

# --- Polling timing (optional, defaults shown) ---
# Minimum / maximum pause between attempts, in seconds.
# CHECK_INTERVAL_MIN=45
# CHECK_INTERVAL_MAX=90
# Total run time before the script exits, in seconds (default 30 min).
# MAX_DURATION_S=1800

# --- Legacy SMTP keys (IGNORED) ---
# SMTP is no longer supported. Notifications are terminal-only.
# The following keys are kept only so existing .env files don't break:
# SMTP_PASSWORD=
# SENDER_EMAIL=
