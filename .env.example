# ============================================================
# Appointment Checker & Auto-Booker - Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Environment variables take precedence over .env values.

# --- Email notification settings ---
# SMTP credentials for sending notification emails
SMTP_PASSWORD=your_smtp_app_password_here
SENDER_EMAIL=your.sender@gmail.com
RECEIVER_EMAIL=your.receiver@example.com

# Optional: override default Gmail SMTP settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Booking details (used to fill the appointment form) ---
# Both FIRST_NAME and LAST_NAME must be set to enable auto-booking.
# If omitted, the script will still detect availability and send an
# email notification, but will NOT auto-book.
FIRST_NAME=Your
LAST_NAME=Name
